#!/usr/bin/env bash
echo category,query,results,time

run() {
    if [ -x "$1" ]; then
        BENCH_CSV=1 "$@"
    else
        echo "aggregate: skip $1 (not built)" >&2
    fi
}

run ./bench-json-c-tcc
run ./bench-json-c-gcc
run ./bench-json-c-clang
run ./bench-yyjson
run ./bench-jsoncons

if command -v node >/dev/null 2>&1 &&
   { [ -d node_modules/jsonpath-plus ] || [ -d ../node_modules/jsonpath-plus ]; }; then
    BENCH_CSV=1 node bench-jsonpath.js
else
    echo "aggregate: skip node bench-jsonpath.js (jsonpath-plus not installed)" >&2
fi

if python3 -c 'import jsonpath_ng' >/dev/null 2>&1; then
    BENCH_CSV=1 python3 bench-jsonpath-ng.py
else
    echo "aggregate: skip python3 bench-jsonpath-ng.py (jsonpath_ng not installed)" >&2
fi

run ./target/release/jsonpath_benchmark
run ../rust/target/release/bench
