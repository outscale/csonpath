#!/bin/sh
set -eu
cd "$(dirname "$0")"

out=${1:-results/v$(sed -n 's/^version = "\(.*\)"/\1/p' ../pyproject.toml)}

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

awk -F, '
  $2 == "TOTAL" { total[$1] = $4 }
  END {
    ref = total["json-c-gcc"]
    if (!ref) { print "make-baseline: no json-c-gcc TOTAL" > "/dev/stderr"; exit 2 }
    for (cat in total) printf "%s,%.4f\n", cat, total[cat] / ref
  }' "$out/results.csv" > "$tmp"

cp "$out/meta.txt" baseline.meta
{
    echo "category,ratio"
    sort "$tmp"
} > baseline.csv
echo "baseline: bench/baseline.csv and bench/baseline.meta"
