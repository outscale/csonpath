#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage() {
    echo "usage: ./do-release VERSION [--skip-tests] [--skip-bench]" >&2
    exit 2
}

[ $# -ge 1 ] || usage
version=${1#v}
shift
skip_tests=0
skip_bench=0
for arg in "$@"; do
    case "$arg" in
        --skip-tests) skip_tests=1 ;;
        --skip-bench) skip_bench=1 ;;
        *) usage ;;
    esac
done

case "$version" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "do-release: invalid version '$version'" >&2; exit 2 ;;
esac

old=$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml | head -1)
[ "$old" != "$version" ] || { echo "do-release: already at $version" >&2; exit 2; }
echo "do-release: $old -> $version"

perl -pi -e "s/^version = \"\Q$old\E\"/version = \"$version\"/" pyproject.toml
perl -pi -e "s/^current_version = \"\Q$old\E\"/current_version = \"$version\"/" pyproject.toml
perl -pi -e "s/^version = \"\Q$old\E\"/version = \"$version\"/" rust/Cargo.toml
perl -pi -e "s/csonpath = \"\Q$old\E\"/csonpath = \"$version\"/" rust/README.md

if [ "$skip_tests" = 0 ]; then
    echo "do-release: tests"
    make tests
fi

if [ "$skip_bench" = 0 ]; then
    echo "do-release: benchmarks"
    ./bench/collect
    ./bench/check
    ./bench/render

    out="bench/results/v$version"
    meta_get() { sed -n "s/^$1: //p" "$out/meta.txt"; }
    gib=$(awk -v b="$(meta_get memory)" 'BEGIN { printf "%.0f", b / 1024 / 1024 / 1024 }')
    section=$(mktemp)
    {
        echo "v$version, $(meta_get date | cut -c1-10), $(meta_get cpu), $gib GiB, $(meta_get os),"
        echo "$(meta_get cc), $(meta_get rustc), json-c $(meta_get json-c), yyjson $(meta_get yyjson)."
        echo
        echo "Times are in seconds. Rows are sorted by query, columns by total time"
        echo "(fastest first). Lower is better."
        echo
        cat "$out/table.md"
    } > "$section"
    awk -v s="$section" '
        /<!-- bench:start -->/ { print; while ((getline line < s) > 0) print line; skip = 1; next }
        /<!-- bench:end -->/ { skip = 0 }
        !skip { print }
    ' bench/Readme.md > "$section.md"
    mv "$section.md" bench/Readme.md
    rm -f "$section"
fi

echo "do-release: cargo publish --dry-run"
cargo publish --dry-run --allow-dirty --manifest-path rust/Cargo.toml

echo "do-release: done, changes are unstaged"
